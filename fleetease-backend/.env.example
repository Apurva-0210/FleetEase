PORT=5000
NODE_ENV=development

# Local PostgreSQL
DB_USER=postgres
DB_PASS=YOUR_POSTGRES_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetease

# Render: use the Internal/External Database URL from the Postgres dashboard instead of DB_* vars
# DATABASE_URL=postgresql://user:pass@host:5432/fleetease

JWT_SECRET=change_this_secret

# Comma-separated frontend origins (localhost + your Vercel URL)
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
