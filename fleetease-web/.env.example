# Local development (copy to .env)
REACT_APP_API_URL=http://localhost:5000/api/v1
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_RAZORPAY_KEY_ID=

# Vercel production — set in Project → Settings → Environment Variables (use REACT_APP_ prefix):
# REACT_APP_API_URL=https://YOUR-SERVICE.onrender.com/api/v1
# REACT_APP_SOCKET_URL=https://YOUR-SERVICE.onrender.com
# (NEXT_PUBLIC_* also works if you already set those on Vercel)
