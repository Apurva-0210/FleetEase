{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fleetease-e86s.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://fleetease-e86s.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!static/).*)",
      "destination": "/index.html"
    }
  ]
}
